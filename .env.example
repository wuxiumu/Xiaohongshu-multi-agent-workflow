# 复制本文件为 .env 后再填写。 .env 已被 gitignore，不要提交。
# 空值表示“未设置”，脚本会继续沿用下一级配置。
# 不要在行尾写注释。
#
# 只看仓库里的样板看板时，下面全部留空即可：
#   php -S 127.0.0.1:8080
#   浏览器打开 http://127.0.0.1:8080/index.html

# --- LLM（expand_keywords.py / judge.py / execute.py 需要；看板不需要）---
# 名称默认来自 collect_config.yaml 的 llm.provider / llm.model。
# LLM_PROVIDER=zhipu
# LLM_MODEL=GLM-5.3-Flash
# openai（默认，智谱等兼容接口）或 anthropic（百炼 token plan）
# LLM_API_TYPE=openai
# 两个都填写时，覆盖 ~/.openclaw/openclaw.json 里的同名 provider。
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=

# 可选。未填 LLM_API_KEY 时，从该 JSON 读取 models.providers.<provider>.apiKey / baseUrl。
# 默认路径：~/.openclaw/openclaw.json
# OPENCLAW_CONFIG_PATH=

# --- 路径（可选，默认都在仓库内）---
# Python 智能体与 api.php 看板都读这个目录。相对路径相对仓库根。
# DATA_DIR=data
# 账号种子词。改品类时通常直接编辑仓库里的 collect_config.yaml，不必改这里。
# COLLECT_CONFIG_PATH=collect_config.yaml
# 小红书扫码登录态。默认 <DATA_DIR>/xhs_state.json，禁止入库。
# XHS_STATE_PATH=data/xhs_state.json

# --- 配图（可选）---
# execute.py 调用该命令生成封面。机器上没有时，成稿仍会写入，只是没有图片。
# BL_BIN=bl
